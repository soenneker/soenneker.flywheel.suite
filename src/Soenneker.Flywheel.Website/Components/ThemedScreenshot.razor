<Anchor Href="@LightSrc" aria-label="@($"View full-size {Label} screenshot")" data-theme-image-link data-light-src="@LightSrc" data-dark-src="@DarkSrc">
    <Picture>
        <PictureSource Source="@DarkSrc" AutoSrcSet="true" Sizes="@ScreenshotSizes" Type="image/avif"
                       IntrinsicWidth="1600" IntrinsicHeight="1050" Media="(prefers-color-scheme: dark)" data-theme-image-dark />
        <Image Source="@LightSrc" AutoSrcSet="true" Sizes="@ScreenshotSizes" IntrinsicWidth="1600" IntrinsicHeight="1050"
               Alt="@Alt" Loading="@(Loading ?? "eager")" FetchPriority="@FetchPriority" />
    </Picture>
</Anchor>

@code {
    private const string ScreenshotSizes = "(max-width: 480px) calc(100vw - 42px), (max-width: 1000px) calc(100vw - 66px), (max-width: 1248px) calc(100vw - 98px), 1150px";
    [Parameter, EditorRequired] public string LightSrc { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string DarkSrc { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Alt { get; set; } = string.Empty;
    [Parameter] public string Label { get; set; } = "dashboard";
    [Parameter] public string? Loading { get; set; }
    [Parameter] public string? FetchPriority { get; set; }
}
