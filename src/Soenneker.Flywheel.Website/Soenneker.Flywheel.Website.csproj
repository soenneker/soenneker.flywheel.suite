<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TailwindGeneratorBuildEnabled>true</TailwindGeneratorBuildEnabled>
        <IsPackable>false</IsPackable>
        <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;out/**</DefaultItemExcludes>
        <RazorSitemapBaseUrl>https://flywheel.soenneker.com/</RazorSitemapBaseUrl>
        <RazorSitemapOutputPath>wwwroot/sitemap.xml</RazorSitemapOutputPath>
        <RazorSitemapIncludeUnannotatedPages>true</RazorSitemapIncludeUnannotatedPages>
        <RazorSitemapEnabled>true</RazorSitemapEnabled>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Soenneker.Gen.Razor.Sitemaps" Version="4.0.135">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Soenneker.Quark.Suite" Version="4.0.1460" Condition="'$(UseLocalQuarkProject)' != 'true'" />
        <ProjectReference Include="$(LocalQuarkProject)" Condition="'$(UseLocalQuarkProject)' == 'true'" />
        <PackageReference Include="Soenneker.Quark.Gen.Tailwind" Version="4.0.268" PrivateAssets="all" />
        <PackageReference Include="Soenneker.Lucide.Icons" Version="5.0.83" />
        <PackageReference Include="Soenneker.Quark.Gen.Lucide" Version="4.0.263" PrivateAssets="all" />
    </ItemGroup>
</Project>
