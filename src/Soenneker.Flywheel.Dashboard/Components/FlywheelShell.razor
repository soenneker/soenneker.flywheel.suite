@namespace Soenneker.Flywheel.Dashboard
@inject DashboardNavigationOptions DashboardNavigation
@inject DashboardSessionState Session
@inject IFlywheelDashboardConsumer Consumer
@inherits LeptonCancellable
@using Soenneker.Quark
@using Soenneker.Lucide.Enums.Icons
@using Microsoft.AspNetCore.Components.Routing

@if (Session.IsAuthenticated)
{
    <SidebarProvider SidebarWidth="14rem" CloseMobileOnNavigation="true" >
        <Sidebar Collapsible="SidebarCollapsible.Icon" >
            <SidebarHeader>
                <SidebarMenu>
                    <SidebarMenuItem>
                        <SidebarMenuButton Href="@DashboardNavigation.HomePath" Tooltip="Flywheel" aria-label="Flywheel" >
                            <Icon Name="LucideIcon.Circle" Size="Size.Is4" />
                            <Span FontWeight="FontWeight.Semibold" >Flywheel</Span>
                        </SidebarMenuButton>
                    </SidebarMenuItem>
                </SidebarMenu>
            </SidebarHeader>
            <SidebarContent>
                <SidebarGroup>
                    <SidebarMenu>
                        <SidebarMenuItem>
                            <SidebarMenuButton Href="/flywheel/recurring" Match="NavLinkMatch.All" Tooltip="Recurring jobs" aria-label="Recurring jobs" >
                                <Icon Name="LucideIcon.Repeat" Size="Size.Is4" /><Span>Recurring jobs</Span>
                            </SidebarMenuButton>
                        </SidebarMenuItem>
                        <SidebarMenuItem>
                            <SidebarMenuButton Href="/flywheel/scheduled" Match="NavLinkMatch.All" Tooltip="Scheduled jobs" aria-label="Scheduled jobs" >
                                <Icon Name="LucideIcon.Clock" Size="Size.Is4" /><Span>Scheduled jobs</Span>
                            </SidebarMenuButton>
                        </SidebarMenuItem>
                        <SidebarMenuItem>
                            <SidebarMenuButton Href="/flywheel/servers" Match="NavLinkMatch.Prefix" Tooltip="Servers" aria-label="Servers" >
                                <Icon Name="LucideIcon.Server" Size="Size.Is4" /><Span>Servers</Span>
                            </SidebarMenuButton>
                        </SidebarMenuItem>
                    </SidebarMenu>
                </SidebarGroup>
            </SidebarContent>
        </Sidebar>
        <SidebarInset MinWidth="MinWidth.Is0" Style="flex: 1; min-width: 0; margin: 0;" >
            <FlywheelHeader />
            <CascadingValue Name="FlywheelSharedHeader" Value="true" IsFixed="true" >
                @ChildContent
            </CascadingValue>
        </SidebarInset>
    </SidebarProvider>
}
else
{
    <CascadingValue Name="FlywheelSharedHeader" Value="true" IsFixed="true" >
        @ChildContent
    </CascadingValue>
}

@code {

    /// <summary>Page content displayed within the dashboard navigation shell.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }


    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        try
        {
            // The CSRF endpoint is anonymous; use a protected endpoint to confirm the session.
            var response = await Consumer.Search(count: 1, cancellationToken: CancellationToken);
            if (!IsDisposed && !IsCancellationRequested)
                Session.SetAuthenticated(response.Succeeded);
        }
        catch (OperationCanceledException) when (IsDisposed || IsCancellationRequested)
        {
        }
        catch (HttpRequestException)
        {
            Session.SetAuthenticated(false);
        }
    }

    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);

    public override async ValueTask DisposeAsync()
    {
        Session.Changed -= OnSessionChanged;
        await base.DisposeAsync();
    }

}