@inject DashboardTimeZone TimeZone
@inject DashboardLogOptions LogOptions
@namespace Soenneker.Flywheel.Dashboard
@using Soenneker.Quark
@using Soenneker.Flywheel.Communication.Responses
@inherits LeptonCancellable
@inject NavigationManager Navigation
@inject ActivityTotalsState ConnectionState
@inject IFlywheelLiveClient Live
@inject IFlywheelDashboardConsumer Consumer

<Section aria-label="Job execution logs" MinWidth="MinWidth.Is0" Style="max-width: 100%;" Margin="Margin.FromTop.Is3">
    <Div Display="Display.Flex" ItemsAlign="Items.Center" Justify="Justify.Between" FlexWrap="FlexWrap.Wrap" Gap="Gap.Is3" Margin="Margin.FromBottom.Is3">
        <H3 TextSize="TextSize.Lg" FontWeight="FontWeight.Semibold" Margin="Margin.Is0">Execution log</H3>
        <Field Style="width: 20rem; max-width: 100%;"><TextInput Id="@($"{_signalId}-search")" @bind-Value="_filter" @bind-Value:after="RefreshEntries" Placeholder="Search logs..." aria-label="Search logs" /></Field>
    </Div>
    @if (_error is not null)
    {
        <Alert role="alert"><AlertDescription>@_error</AlertDescription></Alert>
        @if (_historyCursors.Count > 0)
        {
            <Button OnClick="LoadAllHistory">Retry loading logs</Button>
        }
    }
    <ConsolePanel TextProvider="@(() => ConsoleText)" ItemKeys="@_keys" HasOlderItems="@(_historyCursors.Count > 0 && string.IsNullOrWhiteSpace(_filter) && _error is null)" LoadOlder="LoadOlder" ActionsDisabled="@(_loading || _loadingOlder || _historyCursors.Count > 0)" FormatExceptions="@LogOptions.FormatExceptions" DownloadFileName="@($"{JobId}.log")" SmallScreenHeight="20rem" MediumScreenHeight="28rem" AutoScroll="@(string.IsNullOrWhiteSpace(_filter))" aria-label="Job execution log output">
        <ChildContent>
            @if (_loadingOlder)
            {
                <Paragraph Margin="Margin.Is0" Role="status">Loading log history...</Paragraph>
            }
            @if (_loading && _entries.Count == 0)
            {
                <Div Display="Display.Flex" Justify="Justify.Center" Width="Width.IsFull">
                    <Spinner Size="Size.Is5" aria-label="Loading logs…" />
                </Div>
            }
            else if (!_loading && _entries.Count == 0 && _error is null && _receivedSnapshot)
            {
                <Paragraph Margin="Margin.Is0">No logs recorded for this execution.</Paragraph>
            }
            else if (_entries.Count > 0 && _filteredEntries.Count == 0)
            {
                <Paragraph Margin="Margin.Is0">No matching logs.</Paragraph>
            }
        </ChildContent>
        <ItemTemplate Context="index">
            @{ var entry = _filteredEntries[index]; }
            <ConsoleLogEntry @key="entry.Id" Text="@FormatEntry(entry)" TextColor="@(entry.Level is "Error" or "Critical" ? TextColor.Destructive : entry.Level == "Warning" ? TextColor.Token("amber-700").OnDark.Token("amber-400") : TextColor.Token("inherit"))" />
        </ItemTemplate>
    </ConsolePanel>
</Section>

@code {

    /// <summary>Identifier of the job whose execution logs are displayed.</summary>
    [Parameter, EditorRequired]
    public string JobId { get; set; } = "";

    private readonly string _signalId = $"flywheel-logs-{Guid.NewGuid()}";
    private List<LogEntry> _entries = [];
    private IFlywheelLiveSubscription? _connection;
    private Task? _connecting;
    private string? _jobId;
    private int _version;
    private bool _loading;
    private bool _receivedSnapshot;
    private string? _error;
    private string _filter = "";
    private List<LogEntry> _filteredEntries = [];
    private string[] _keys = [];
    private readonly Queue<string> _historyCursors = new();
    private bool _loadingOlder;

    private void RefreshEntries()
    {
        _filteredEntries = _entries.Where(entry => string.IsNullOrWhiteSpace(_filter) ||
            $"{FormatEntry(entry)} {entry.Category} Attempt {entry.Attempt}".Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
        _keys = _filteredEntries.Select(entry => entry.Id).ToArray();
    }

    private async Task LoadOlder()
    {
        if (_loadingOlder || _historyCursors.Count == 0) return;
        int version = _version;
        string jobId = JobId;
        _loadingOlder = true;
        _error = null;
        string? activeCursor = null;
        try
        {
            if (_historyCursors.TryDequeue(out string? beforeId))
            {
                activeCursor = beforeId;
                var known = _entries.Select(entry => entry.Id).ToHashSet();
                var response = await Consumer.GetLogs(jobId, beforeId, CancellationToken);
                if (IsDisposed || version != _version) return;
                if (!response.Succeeded || response.Value is null)
                {
                    _historyCursors.Enqueue(beforeId);
                    _error = "Could not load the complete log history. Retry to include all retained logs.";
                    return;
                }
                var page = response.Value;
                bool reachedKnown = page.Any(entry => known.Contains(entry.Id));
                MergeEntries(page);
                if (page.Count == 200 && !reachedKnown && page[0].Id != beforeId)
                    _historyCursors.Enqueue(page[0].Id);
                RefreshEntries();
                StateHasChanged();
            }
        }
        catch (OperationCanceledException) when (IsDisposed || IsCancellationRequested) { }
        catch (Exception)
        {
            if (!IsDisposed && version == _version)
            {
                if (activeCursor is not null) _historyCursors.Enqueue(activeCursor);
                _error = "Could not load the complete log history. Retry to include all retained logs.";
            }
        }
        finally
        {
            if (version == _version) _loadingOlder = false;
        }
    }

    private async Task LoadAllHistory()
    {
        int version = _version;
        do
        {
            if (_loadingOlder || IsDisposed || IsCancellationRequested || version != _version) return;
            await LoadOlder();
        }
        while (_historyCursors.Count > 0 && _error is null);
    }

    private void MergeEntries(IEnumerable<LogEntry> entries) =>
        _entries = _entries.Concat(entries).DistinctBy(entry => entry.Id)
            .OrderBy(entry => long.TryParse(entry.Id.AsSpan(entry.Id.LastIndexOf('-') + 1), out long sequence) ? sequence : entry.Timestamp)
            .ToList();

    private string FormatEntry(LogEntry entry) =>
        $"{TimeZone.Format(entry.Timestamp, "yyyy-MM-dd HH:mm:ss.fff")} [{entry.Level}] {TimeZone.FormatMessage(entry.Message)}";

    private string ConsoleText => string.Join(Environment.NewLine, _filteredEntries.Select(FormatEntry));

    protected override async Task OnParametersSetAsync()
    {
        if (_jobId == JobId) { RefreshEntries(); return; }
        _jobId = JobId;
        _version++;
        _entries = [];
        RefreshEntries();
        _historyCursors.Clear();
        _loadingOlder = false;
        _receivedSnapshot = false;
        _error = null;
        _filter = "";
        _loading = true;
        if (_connection?.IsConnected == true) await SubscribeLive();
        else _connecting ??= Connect();
    }

    private Task SubscribeLive() => _connection is null ? Task.CompletedTask :
        _connection.SubscribeLogs(_version, JobId, CancellationToken);

    private async Task Connect()
    {
        ConnectionState.UpdateConnection(_signalId, false);
        try
        {
            _connection = await Live.Logs(_signalId, snapshot => InvokeAsync(async () =>
            {
                if (IsDisposed || IsCancellationRequested || snapshot.Version != _version || snapshot.JobId != JobId) return;
                ConnectionState.UpdateConnection(_signalId, true);
                _receivedSnapshot = true;
                if (snapshot.Entries is { Count: > 0 } incoming)
                {
                    if (incoming.Count == 200 && !_entries.Any(entry => entry.Id == incoming[0].Id))
                        _historyCursors.Enqueue(incoming[0].Id);
                    MergeEntries(incoming);
                }
                RefreshEntries();
                _error = snapshot.Entries is null ? "Logs are unavailable from this job store." : null;
                _loading = false;
                StateHasChanged();
                await LoadAllHistory();
            }), () => InvokeAsync(SubscribeLive),
                () => InvokeAsync(() => { ConnectionState.UpdateConnection(_signalId, false); _loading = false; StateHasChanged(); }), CancellationToken);
            await _connection.Start(CancellationToken);
            if (!IsDisposed && !IsCancellationRequested && !_connection.IsConnected)
            {
                _loading = false;
                ConnectionState.UpdateConnection(_signalId, false);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (IsDisposed || IsCancellationRequested) { }
        catch (Exception)
        {
            ConnectionState.UpdateConnection(_signalId, false);
            _loading = false;
            if (!IsDisposed && !IsCancellationRequested) await InvokeAsync(StateHasChanged);
        }
    }

    public override async ValueTask DisposeAsync()
    {
        await base.DisposeAsync();
        if (_connecting is not null) await _connecting;
        if (_connection is not null) await _connection.DisposeAsync();
        ConnectionState.RemoveConnection(_signalId);
    }
}

@code {
    [CascadingParameter(Name = "DisplayTimeZone")] public string DisplayTimeZone { get; set; } = "UTC";
}
