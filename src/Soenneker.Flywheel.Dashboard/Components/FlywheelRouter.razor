@using Soenneker.Flywheel.Communication.Enums
@namespace Soenneker.Flywheel.Dashboard
@using Microsoft.AspNetCore.Components.Routing
@inject DashboardNavigationOptions DashboardNavigation
@inject NavigationManager Navigation
@inject INavigationInterception NavigationInterception
@inject IScrollToLocationHash ScrollToLocationHash
@implements IDisposable

@if (_route.Page == DashboardPage.NotFound)
{
    @if (NotFound is not null)
    {
        @NotFound(_path)
    }
    else
    {
        <p role="alert">Page not found.</p>
    }
}
else
{
    <RouteView RouteData="@(_routeData!)" DefaultLayout="@typeof(FlywheelLayout)" />
}

@code {
    /// <summary>Content for host pages or unknown URLs. Receives the base-relative path without the query string or fragment. Routes are not discovered from assemblies.</summary>
    [Parameter]
    public RenderFragment<string>? NotFound { get; set; }

    private DashboardRoute _route;
    private RouteData? _routeData;
    private string _path = "";
    private bool _refreshScroll;
    private bool _disposed;

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    protected override void OnParametersSet() => ResolveRoute();

    private void ResolveRoute()
    {
        string relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        _path = relative.Split('?', '#')[0];
        _route = DashboardRoute.Match(relative, DashboardNavigation.HomePath);
        Type? pageType = _route.Page switch
        {
            var page when page == DashboardPage.Dashboard => typeof(Pages.Dashboard.Dashboard),
            var page when page == DashboardPage.SignIn => typeof(Pages.Authentication.SignIn),
            var page when page == DashboardPage.Recurring => typeof(Pages.Schedules.Schedules),
            var page when page == DashboardPage.Schedule => typeof(Pages.Schedules.Schedule),
            var page when page == DashboardPage.Scheduled => typeof(Pages.Jobs.Jobs),
            var page when page == DashboardPage.Jobs => typeof(Pages.Jobs.Job),
            var page when page == DashboardPage.Servers => typeof(Pages.Servers.Servers),
            var page when page == DashboardPage.ServerDetails => typeof(Pages.Servers.Server),
            _ => null
        };
        var parameters = new Dictionary<string, object?>();
        if (_route.Page == DashboardPage.Jobs) parameters[nameof(Pages.Jobs.Job.JobId)] = _route.Id!;
        if (_route.Page == DashboardPage.Schedule) parameters[nameof(Pages.Schedules.Schedule.ScheduleId)] = _route.Id!;
        if (_route.Page == DashboardPage.ServerDetails) parameters[nameof(Pages.Servers.Server.ServerId)] = _route.Id!;
        _routeData = pageType is null ? null : new RouteData(pageType, parameters);
        _refreshScroll = true;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = InvokeAsync(() =>
        {
            if (_disposed)
                return;
            ResolveRoute();
            StateHasChanged();
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await NavigationInterception.EnableNavigationInterceptionAsync();
        if (!_disposed && _refreshScroll)
        {
            _refreshScroll = false;
            await ScrollToLocationHash.RefreshScrollPositionForHash(Navigation.Uri);
        }
    }

    public void Dispose()
    {
        _disposed = true;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
