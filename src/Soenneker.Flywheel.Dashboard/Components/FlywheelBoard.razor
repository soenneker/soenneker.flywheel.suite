@namespace Soenneker.Flywheel.Dashboard
@using Soenneker.Quark
@using Soenneker.Flywheel.Communication.Responses
@using System.Net
@using Microsoft.AspNetCore.Components
@using Soenneker.DataTables.Dtos.ServerSideRequest
@inherits LeptonCancellable
@inject IFlywheelDashboardConsumer Consumer
@inject ActivityTotalsState ActivityTotals
@inject DashboardSessionState Session
@inject NavigationManager Navigation
@inject DashboardNavigationOptions DashboardNavigation
@inject IFlywheelLiveClient Live

<Div Width="Width.IsFull" MinWidth="MinWidth.Is0" Padding="Padding.Is4" Style="width: 100%; max-width: none; margin: 0;">
    @if (_error is not null)
    {
        <Alert role="alert" Margin="Margin.FromBottom.Is4"><AlertTitle>Unable to complete the request</AlertTitle><AlertDescription>@_error <Button OnClick="RefreshPage" Variant="ButtonVariant.Secondary">Reload page</Button></AlertDescription></Alert>
    }
    @if (!_authChecked)
    {
        <Div role="status" aria-busy="true" TextAlign="TextAlign.Center" Padding="Padding.Is8" TextSize="TextSize.Sm" TextColor="TextColor.MutedForeground">Loading jobs…</Div>
    }
    else if (_login)
    {
        <Section  MaxWidth="MaxWidth.IsMd" Margin="Margin.Auto.OnX" Padding="Padding.Is12.OnY">
            <Div MinWidth="MinWidth.Is0" Space="Space.Y.Is4">
                <Div>
                    <H1 TextSize="TextSize.Xl" FontWeight="FontWeight.Semibold" TextBreak="TextBreak.Words" Display="Display.Flex" Justify="Justify.Center">
                        <Anchor Href="@DashboardNavigation.HomePath" Display="Display.InlineFlex" ItemsAlign="Items.Center" Gap="Gap.Is2">
                            <Icon Name="Soenneker.Lucide.Enums.Icons.LucideIcon.Circle" Size="Size.Is5" aria-hidden="true" />
                            <Span>Flywheel</Span>
                        </Anchor>
                    </H1>
                    <form @onsubmit="Login" @onsubmit:preventDefault >
                        <Field Margin="Margin.Is4.OnY"><FieldLabel For="flywheel-user">Username</FieldLabel><TextInput Id="flywheel-user" autocomplete="username" @bind-Value="_username" Required="true" MaxLength="128" /></Field>
                        <Field Margin="Margin.Is4.OnY"><FieldLabel For="flywheel-password">Password</FieldLabel><PasswordInput Id="flywheel-password" autocomplete="current-password" @bind-Value="_password" Required="true" MaxLength="1024" /></Field>
                        <Button Width="Width.IsFull" Margin="Margin.FromTop.Is3" Type="ButtonType.Submit" Disabled="@_busy" Loading="@_busy">@(_busy ? "Signing in…" : "Sign in →")</Button>
                    </form>
                </Div>
            </Div>
        </Section>
    }
    else if (!SignInOnly && _error is null)
    {
        <Drawer @ref="_jobDrawer" Visible="@(_selectedJob is not null || _selectedSchedule is not null)" VisibleChanged="OnJobDrawerVisibleChanged" Direction="right" TrapFocus="true" ShowBackdrop="true">
        @if (View == "overview")
        {
        <Div Display="Display.Flex" ItemsAlign="Items.Center" Gap="Gap.Is4" FlexWrap="FlexWrap.Wrap" Justify="Justify.Between" Margin="Margin.FromBottom.Is4">
            <Button Variant="@(_lastHour ? ButtonVariant.Secondary : ButtonVariant.Outline)" OnClick="ShowLastHour">Last hour</Button>
            <PresetDateRangePicker Placeholder="Date range" SelectedRange="@(_lastHour ? null : SelectedHistoryRange)"
                                   SelectedRangeChanged="SetHistoryRange"
                                   Min="@HistoryMinDate"
                                   Max="@HistoryMaxDate"
                                   MaxRangeDays="@_historyRetentionDays"
                                   DisableDatesOutsideMaxRangeWindow="true"
                                   RangePresets="@HistoryRangePresets"
                                   ShowCalendarIcon="false"
                                   Disabled="@_historyLoading"
                                   AriaLabel="Select job activity date range" />
        </Div>
        <Grid aria-label="Job summaries" Columns="GridCols.Is1" Margin="Margin.FromBottom.Is6" Padding="Padding.FromBottom.Is6" Border="Border.FromBottom.Is1" BorderColor="BorderColor.Border">
            <Div MinWidth="MinWidth.Is0" Space="Space.Y.Is4">
                <Div>
                    @if (_historyError is not null)
                    {
                        <Paragraph role="status" >@_historyError</Paragraph>
                    }
                    else
                    {
                        <Div Overflow="Overflow.Auto" tabindex="0" aria-label="Activity chart; scroll horizontally on narrow screens">
                            <Div MinWidth='MinWidth.Token("[900px]")' Overflow="Overflow.Hidden">
                                <Chart @key="_activityChartKey" DataVersion="@_activityVersion" Type="ChartType.Line" Labels="@_activityLabels" XValues="@_activityXValues" Series="@_activitySeries" Options="@_activityOptions"
                                       OnRangeSelect="SelectActivityRange"
                                       AriaLabel="Job activity across all jobs over the selected date range, in five-minute UTC buckets. Select a point or drag a range to filter executions." />
                            </Div>
                        </Div>
                    }
                </Div>
            </Div>
        </Grid>
        }
        @if (View == "recurring")
        {
            <Div MinWidth="MinWidth.Is0" Space="Space.Y.Is4">
                <Div Space="Space.Y.Is1"><H3 TextSize="TextSize.Lg" FontWeight="FontWeight.Semibold">Recurring jobs</H3></Div>
                <DataTable Options="@_recurringTableOptions" TotalRecords="@FilteredRecurring.Count" OnInteraction="SearchRecurring">
                    <TopContent>
                        <Div Display="Display.Flex" ItemsAlign="Items.Center" Gap="Gap.Is2" Margin="Margin.FromBottom.Is4">
                            <DataTableSearch Placeholder="Search" AriaLabel="Search recurring jobs" />
                            <SidebarTrigger Display="Display.Flex.OnMd.None" aria-label="Open navigation menu"><Icon Name="Soenneker.Lucide.Enums.Icons.LucideIcon.Menu" Size="Size.Is5" /></SidebarTrigger>
                        </Div>
                    </TopContent>
                    <TableContent>
                        <Thead BackgroundColor="BackgroundColor.Secondary" Border="Border.FromBottom.Is2" BorderColor="BorderColor.Border"><Tr><Th FontWeight="FontWeight.Semibold" TextColor="TextColor.Foreground" TextSize="TextSize.Xs" TextTransform="TextTransform.Uppercase" Tracking="Tracking.Wide" Padding="Padding.Is3">Job</Th><Th FontWeight="FontWeight.Semibold" TextColor="TextColor.Foreground" TextSize="TextSize.Xs" TextTransform="TextTransform.Uppercase" Tracking="Tracking.Wide" Padding="Padding.Is3">Schedule</Th><Th FontWeight="FontWeight.Semibold" TextColor="TextColor.Foreground" TextSize="TextSize.Xs" TextTransform="TextTransform.Uppercase" Tracking="Tracking.Wide" Padding="Padding.Is3">Next run</Th><Th FontWeight="FontWeight.Semibold" TextColor="TextColor.Foreground" TextSize="TextSize.Xs" TextTransform="TextTransform.Uppercase" Tracking="Tracking.Wide" Padding="Padding.Is3">Action</Th></Tr></Thead><Tbody>
                        @foreach (var schedule in FilteredRecurring.Skip(RecurringOffset).Take(_recurringPageSize))
                        {
                            <Tr Border="Border.FromBottom.Is1" BorderColor="BorderColor.Border" @key="schedule.Id" tabindex="0" Style="cursor: pointer;" @onclick="() => ShowScheduleDrawer(schedule)" @onkeydown="e => OpenScheduleDrawer(e, schedule)">
                                <Td>@schedule.Name</Td>
                                <Td>@(schedule.Cron is null ? $"Every {IntervalLabel(schedule.Interval)}" : $"{schedule.Cron} ({schedule.TimeZoneId})")</Td>
                                <Td><JobTimestamp StartsAt="true" Value="@schedule.DueAt" /></Td>
                                <Td><span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><Button OnClick="() => RunRecurring(schedule.Id)" Disabled="@_startingSchedules.Contains(schedule.Id)" Loading="@_startingSchedules.Contains(schedule.Id)" Variant="ButtonVariant.Secondary" aria-label="@($"Run {schedule.Name} now")">Run now</Button></span></Td>
                            </Tr>
                        }
                        </Tbody>
                    </TableContent>
                    <BottomContent>
                        @if (_scheduleError is not null)
                        {
                            <Paragraph role="status">@_scheduleError</Paragraph>
                        }
                        else if (_schedules is null)
                        {
                            <Paragraph>Loading schedules…</Paragraph>
                        }
                        else if (!FilteredRecurring.Any())
                        {
                            <Paragraph TextColor="TextColor.MutedForeground">No matching recurring jobs.</Paragraph>
                        }
                        <Div Display="Display.Flex" ItemsAlign="Items.Center" FlexWrap="FlexWrap.Wrap" Justify="Justify.Between" Gap="Gap.Is4" Margin="Margin.FromTop.Is4">
                            <DataTablePageSizeSelector Label="Rows per page" />
                            <DataTablePagination />
                        </Div>
                        @if (_schedules?.Recurring.Count == 200)
                        {
                            <Small TextColor="TextColor.MutedForeground">Search and paging cover the next 200 recurring jobs.</Small>
                        }
                    </BottomContent>
                </DataTable>
            </Div>
        }
        @if (View == "scheduled")
        {
            <Div MinWidth="MinWidth.Is0" Space="Space.Y.Is4">
                <Div Space="Space.Y.Is1"><H3 TextSize="TextSize.Lg" FontWeight="FontWeight.Semibold">Scheduled jobs</H3></Div>
                <DataTable Options="@_scheduledTableOptions" TotalRecords="@FilteredScheduled.Count" OnInteraction="SearchScheduled">
                    <TopContent>
                        <Div Display="Display.Flex" ItemsAlign="Items.Center" Gap="Gap.Is2" Margin="Margin.FromBottom.Is4">
                            <DataTableSearch Placeholder="Search" AriaLabel="Search scheduled jobs" />
                            <SidebarTrigger Display="Display.Flex.OnMd.None" aria-label="Open navigation menu"><Icon Name="Soenneker.Lucide.Enums.Icons.LucideIcon.Menu" Size="Size.Is5" /></SidebarTrigger>
                        </Div>
                    </TopContent>
                    <TableContent>
                        <Thead BackgroundColor="BackgroundColor.Secondary" Border="Border.FromBottom.Is2" BorderColor="BorderColor.Border"><Tr><Th FontWeight="FontWeight.Semibold" TextColor="TextColor.Foreground" TextSize="TextSize.Xs" TextTransform="TextTransform.Uppercase" Tracking="Tracking.Wide" Padding="Padding.Is3">Job</Th><Th FontWeight="FontWeight.Semibold" TextColor="TextColor.Foreground" TextSize="TextSize.Xs" TextTransform="TextTransform.Uppercase" Tracking="Tracking.Wide" Padding="Padding.Is3">Scheduled for</Th><Th FontWeight="FontWeight.Semibold" TextColor="TextColor.Foreground" TextSize="TextSize.Xs" TextTransform="TextTransform.Uppercase" Tracking="Tracking.Wide" Padding="Padding.Is3">Attempt</Th></Tr></Thead><Tbody>
                        @foreach (var job in FilteredScheduled.Skip(ScheduledOffset).Take(_scheduledPageSize))
                        {
                            <Tr Border="Border.FromBottom.Is1" BorderColor="BorderColor.Border" @key="job.Id" tabindex="0" Style="cursor: pointer;" @onclick="() => ShowJobDrawer(job)" @onkeydown="e => OpenJobDrawer(e, job)"><Td><span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><Anchor Href="@($"jobs/{Uri.EscapeDataString(job.Id)}")">@job.Name</Anchor></span></Td><Td><JobTimestamp StartsAt="true" Value="@job.DueAt" /></Td><Td>@(job.Attempt == 0 ? "—" : job.MaxAttempts is { } max ? $"{job.Attempt} / {max}" : job.Attempt.ToString())</Td></Tr>
                        }
                        </Tbody>
                    </TableContent>
                    <BottomContent>
                        @if (_scheduleError is not null)
                        {
                            <Paragraph role="status">@_scheduleError</Paragraph>
                        }
                        else if (_schedules is null)
                        {
                            <Paragraph>Loading schedules…</Paragraph>
                        }
                        else if (!FilteredScheduled.Any())
                        {
                            <Paragraph TextColor="TextColor.MutedForeground">No matching scheduled jobs.</Paragraph>
                        }
                        <Div Display="Display.Flex" ItemsAlign="Items.Center" FlexWrap="FlexWrap.Wrap" Justify="Justify.Between" Gap="Gap.Is4" Margin="Margin.FromTop.Is4">
                            <DataTablePageSizeSelector Label="Rows per page" />
                            <DataTablePagination />
                        </Div>
                        @if (_schedules?.Scheduled.Count == 200)
                        {
                            <Small TextColor="TextColor.MutedForeground">Search and paging cover the next 200 scheduled jobs.</Small>
                        }
                    </BottomContent>
                </DataTable>
            </Div>
        }
        @if (View == "overview")
        {
        <Grid aria-label="Recent job activity" Columns="GridCols.Is1">
            <Div MinWidth="MinWidth.Is0" Space="Space.Y.Is4">

                <Div Display="Display.Flex" ItemsAlign="Items.Center" FlexWrap="FlexWrap.Wrap" Gap="Gap.Is4">
                    <H3 Margin="Margin.Is0" TextSize="TextSize.Lg" FontWeight="FontWeight.Semibold">Executions</H3>
                    @if (_jobStartAt is { } jobStart && _jobEndAt is { } jobEnd)
                    {
                        <Span TextSize="TextSize.Sm" TextColor="TextColor.MutedForeground">@($"{jobStart:MMM d HH:mm}–{jobEnd:MMM d HH:mm} UTC")</Span>
                        <Button Variant="ButtonVariant.Ghost" OnClick="ClearActivitySelection">Clear time filter</Button>
                    }
                </Div>
                <Div>
                <DataTable Options="@_tableOptions" TotalRecords="@_totalCount" OnInteraction="SearchJobs" >
                    <TopContent>
                        <Div Display="Display.Flex" ItemsAlign="Items.Center" Gap="Gap.Is2" Justify="Justify.Between" Margin="Margin.FromBottom.Is4">
                            <DataTableSearch Placeholder="Search" AriaLabel="Search jobs" SearchTermChanged="SearchTextChanged" />
                            @if (!string.IsNullOrWhiteSpace(_query))
                            {
                                <Span aria-live="polite">@_totalCount matching jobs</Span>
                            }
                            <SidebarTrigger Display="Display.Flex.OnMd.None" aria-label="Open navigation menu"><Icon Name="Soenneker.Lucide.Enums.Icons.LucideIcon.Menu" Size="Size.Is5" /></SidebarTrigger>
                        </Div>
                    </TopContent>
                    <TableContent>
                        <Thead BackgroundColor="BackgroundColor.Secondary" Border="Border.FromBottom.Is2" BorderColor="BorderColor.Border">
                            <Tr>
                                <Th FontWeight="FontWeight.Semibold" TextColor="TextColor.Foreground" TextSize="TextSize.Xs" TextTransform="TextTransform.Uppercase" Tracking="Tracking.Wide" Padding="Padding.Is3">Job</Th><Th FontWeight="FontWeight.Semibold" TextColor="TextColor.Foreground" TextSize="TextSize.Xs" TextTransform="TextTransform.Uppercase" Tracking="Tracking.Wide" Padding="Padding.Is3">Status</Th><Th FontWeight="FontWeight.Semibold" TextColor="TextColor.Foreground" TextSize="TextSize.Xs" TextTransform="TextTransform.Uppercase" Tracking="Tracking.Wide" Padding="Padding.Is3">Attempt</Th><Th FontWeight="FontWeight.Semibold" TextColor="TextColor.Foreground" TextSize="TextSize.Xs" TextTransform="TextTransform.Uppercase" Tracking="Tracking.Wide" Padding="Padding.Is3">Updated</Th><Th FontWeight="FontWeight.Semibold" TextColor="TextColor.Foreground" TextSize="TextSize.Xs" TextTransform="TextTransform.Uppercase" Tracking="Tracking.Wide" Padding="Padding.Is3">Action</Th>
                            </Tr>
                        </Thead>
                        <Tbody>
                            @foreach (var job in _jobs)
                            {
                                <Tr Border="Border.FromBottom.Is1" BorderColor="BorderColor.Border" @key="job.Id" tabindex="0" style="cursor: pointer;" aria-label="@($"View details for {job.Name}")" @onclick="() => ShowJobDrawer(job)" @onkeydown="e => OpenJobDrawer(e, job)">
                                        <Td>
                                            <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><Anchor Href="@($"jobs/{Uri.EscapeDataString(job.Id)}")">@job.Name</Anchor></span>
                                        </Td>
                                        <Td>
                                            <JobStatusBadge State="@job.State" CancelRequested="@job.CancelRequested" />
                                        </Td>
                                        <Td>@(job.Attempt == 0 ? "—" : job.MaxAttempts is { } max ? $"{job.Attempt} / {max}" : job.Attempt.ToString())</Td><Td><JobTimestamp Value="@job.UpdatedAt" /></Td>
                                        <Td>
                                            @if (job.State is "Scheduled" or "Running" or "Waiting")
                                            {
                                                <span @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><Button Disabled="@(job.CancelRequested || _cancellingJobs.Contains(job.Id))" OnClick="() => Cancel(job.Id)" Variant="ButtonVariant.Secondary" aria-label="@($"Cancel {job.Name}")">@(job.CancelRequested ? "Cancellation requested" : "Cancel")</Button></span>
                                            }
                                        </Td>
                                </Tr>
                            }
                        </Tbody>
                    </TableContent>
                    <BottomContent>
                        @if (_jobs.Count == 0)
                        {
                            <Div  TextAlign="TextAlign.Center" Padding="Padding.Is8" TextSize="TextSize.Sm" TextColor="TextColor.MutedForeground">
                                <H3 TextSize="TextSize.Xl" FontWeight="FontWeight.Semibold" TextBreak="TextBreak.Words">@(string.IsNullOrEmpty(_query) ? (_totalCount == 0 ? "No executions yet" : "No executions on this page") : "No matching jobs")</H3>
                                <Paragraph >@(string.IsNullOrEmpty(_query) ? "New executions appear here automatically. Use the page controls to return to earlier results." : "Try a job name, ID, worker, or a status such as DeadLettered. Clear the search to see all executions.")</Paragraph>
                            </Div>
                        }
                        <Div Display="Display.Flex" ItemsAlign="Items.Center" Gap="Gap.Is4" FlexWrap="FlexWrap.Wrap" Justify="Justify.Between" Margin="Margin.FromTop.Is4">
                            <DataTablePageSizeSelector Label="Rows per page" />
                            <DataTablePagination />
                        </Div>
                    </BottomContent>
                </DataTable>
                </Div>
            </Div>
        </Grid>
        }
        <DrawerContent Style="@(_selectedSchedule is not null ? "width: 100vw; max-width: 40rem;" : "width: 100vw; max-width: 56rem;")" Padding="Padding.Is4.OnMd.Is6">
            @if (_selectedJob is { } selectedJob)
            {
                <DrawerTitle ScreenReader="ScreenReader.Only">@selectedJob.Name</DrawerTitle>
                <Soenneker.Flywheel.Dashboard.Pages.JobDetails @key="selectedJob.Id" JobId="@selectedJob.Id" Embedded="true" />
            }
            else if (_selectedSchedule is { } selectedSchedule)
            {
                <DrawerHeader Padding="Padding.Is0" Margin="Margin.FromBottom.Is6">
                    <Div Display="Display.Flex" Justify="Justify.Between" ItemsAlign="Items.Start" Gap="Gap.Is4">
                        <Div Display="Display.Flex" ItemsAlign="Items.Center" FlexWrap="FlexWrap.Wrap" Gap="Gap.Is3" MinWidth="MinWidth.Is0">
                            <DrawerTitle Margin="Margin.Is0" TextBreak="TextBreak.Words">@selectedSchedule.Name</DrawerTitle>
                            <Badge Variant="BadgeVariant.Secondary">Recurring</Badge>
                        </Div>
                        <Div Display="Display.Flex" ItemsAlign="Items.Center" Gap="Gap.Is2" FlexWrap="FlexWrap.Wrap">
                            <Button OnClick="() => RunRecurring(selectedSchedule.Id)" Loading="@_startingSchedules.Contains(selectedSchedule.Id)" Disabled="@_startingSchedules.Contains(selectedSchedule.Id)" Variant="ButtonVariant.Secondary">Run now</Button>
                            <DrawerClose AsChild="true"><Button Variant="ButtonVariant.Secondary" aria-label="Close recurring job">Close</Button></DrawerClose>
                        </Div>
                    </Div>
                </DrawerHeader>
                <Grid Style="display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 1.5rem;" Padding="Padding.FromBottom.Is6" Border="Border.FromBottom.Is1" BorderColor="BorderColor.Border">
                    <Div Space="Space.Y.Is2">
                        <Span Display="Display.Block" TextSize="TextSize.Xs" TextColor="TextColor.MutedForeground">Schedule</Span>
                        <Span Display="Display.Block" FontWeight="FontWeight.Medium">@(selectedSchedule.Cron is null ? $"Every {IntervalLabel(selectedSchedule.Interval)}" : selectedSchedule.Cron)</Span>
                        @if (selectedSchedule.Cron is not null)
                        {
                            <Span Display="Display.Block" TextSize="TextSize.Sm" TextColor="TextColor.MutedForeground">@selectedSchedule.TimeZoneId</Span>
                        }
                    </Div>
                    <Div Space="Space.Y.Is2">
                        <Div Display="Display.Flex" ItemsAlign="Items.Center" Gap="Gap.Is2">
                            <Span TextSize="TextSize.Xs" TextColor="TextColor.MutedForeground">Next execution</Span>
                            <JobStatusBadge State="Scheduled" />
                        </Div>
                        <JobTimestamp StartsAt="true" Value="@selectedSchedule.DueAt" ShowAbsolute="true" />
                    </Div>
                </Grid>

            }
        </DrawerContent>
        </Drawer>
    }
</Div>
