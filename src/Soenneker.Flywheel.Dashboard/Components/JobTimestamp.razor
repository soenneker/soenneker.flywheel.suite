@inject DashboardTimeZone TimeZone
@namespace Soenneker.Flywheel.Dashboard
@using Soenneker.Quark

@if (Value > 0)
{
    @if (StartsAt)
    {
        <DateUntil Value="@DateTimeOffset.FromUnixTimeMilliseconds(Value)" ExpiredText="Starts now" title="@TimeZone.Format(Value, "yyyy-MM-dd HH:mm:ss.fff")" />
    }
    else
    {
    <DateRelative Value="@DateTimeOffset.FromUnixTimeMilliseconds(Value)" title="@TimeZone.Format(Value, "yyyy-MM-dd HH:mm:ss.fff")" />
    }
    @if (ShowAbsolute)
    {
        <Span Display="Display.Block" TextSize="TextSize.Xs" TextColor="TextColor.MutedForeground">@TimeZone.Format(Value)</Span>
    }
}
else
{
    <Span>—</Span>
}

@code {
    /// <summary>The UTC Unix timestamp in milliseconds, or zero when unavailable.</summary>
    [Parameter]
    public long Value { get; set; }

    /// <summary>Shows the exact time in the selected timezone beneath the relative time, including on touch devices.</summary>
    [Parameter]
    public bool ShowAbsolute { get; set; }

    /// <summary>Counts down to a scheduled start and displays Starts now once due.</summary>
    [Parameter]
    public bool StartsAt { get; set; }
}

@code {
    [CascadingParameter(Name = "DisplayTimeZone")] public string DisplayTimeZone { get; set; } = "UTC";
}
