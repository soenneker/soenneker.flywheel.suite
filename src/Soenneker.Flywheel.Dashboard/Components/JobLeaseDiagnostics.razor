@namespace Soenneker.Flywheel.Dashboard
@using Soenneker.Bradix
@using Soenneker.Quark
@using Soenneker.Flywheel.Communication.Responses
@inject DashboardTimeZone TimeZone

@if (Job.LastOwner is not null || Job.LeaseLossReason is not null)
{
    <HoverCard OpenDelay="200">
        <HoverCardTrigger AsChild="true">
            <Button Variant="ButtonVariant.Link" TextSize="TextSize.Sm" TextColor="TextColor.MutedForeground" Style="height: auto; padding: 0;">Lease diagnostics</Button>
        </HoverCardTrigger>
        <HoverCardContent Side="Side.Bottom" Align="Alignment.Start" CollisionPadding="16" Style="width: 24rem; max-width: calc(100vw - 2rem); overflow-wrap: anywhere;">
            <H3 TextSize="TextSize.Sm" FontWeight="FontWeight.Semibold" Margin="Margin.FromBottom.Is3">Lease diagnostics</H3>
            <dl style="margin: 0; display: grid; gap: .25rem;">
                <dt>Latest attempt worker</dt>
                <dd style="margin: 0 0 .5rem;">@(Job.LastOwner ?? "Unavailable")</dd>
                <dt>Last successful renewal</dt>
                <dd style="margin: 0 0 .5rem;">@FormatTime(Job.LastLeaseRenewedAt)</dd>
                <dt>Last granted lease deadline</dt>
                <dd style="margin: 0;">@FormatTime(Job.LastLeaseUntil)</dd>
                @if (Job.LeaseLossReason is { } reason)
                {
                    <dt style="margin-top: .5rem;">Lease loss reason</dt>
                    <dd style="margin: 0;">@reason</dd>
                }
            </dl>
        </HoverCardContent>
    </HoverCard>
}

@code {
    [Parameter, EditorRequired]
    public JobView Job { get; set; } = default!;

    private string FormatTime(long value) => value > 0
        ? TimeZone.Convert(DateTimeOffset.FromUnixTimeMilliseconds(value)).ToString("yyyy-MM-dd HH:mm:ss.fff zzz", System.Globalization.CultureInfo.InvariantCulture)
        : "Not recorded";
}
