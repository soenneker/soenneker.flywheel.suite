@namespace Soenneker.Flywheel.Dashboard
@using Soenneker.Quark
@using Soenneker.Flywheel.Communication.Responses

<Section aria-label="Execution activity" Style="min-width: 0; padding-top: .75rem;">
    <Div Display="Display.Flex" ItemsAlign="Items.Center" Justify="Justify.Between" FlexWrap="FlexWrap.Wrap" Gap="Gap.Is2" Margin="Margin.FromBottom.Is4">
        <H3 TextSize="TextSize.Sm" FontWeight="FontWeight.Semibold" Margin="Margin.Is0">Activity</H3>
        <Span TextSize="TextSize.Xs" TextColor="TextColor.MutedForeground">
            @(Job.MaxAttempts is { } max ? $"Attempt {Job.Attempt} of {max}" : $"Attempt {Job.Attempt}")
            @if (Job.StartedAt > 0 && Job.CompletedAt >= Job.StartedAt)
            {
                <Span> · Completed in @DurationLabel</Span>
            }
        </Span>
    </Div>
    <Div Style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); gap: 1rem 1.5rem;">
        @foreach (var (title, timestamp, pending, step) in Milestones)
        {
            <Div @key="step" Style="min-width: 0; overflow-wrap: anywhere;">
                <Span Display="Display.Block" TextSize="TextSize.Sm" FontWeight="FontWeight.Semibold" Margin="Margin.FromBottom.Is1">@title</Span>
                <Div TextSize="TextSize.Sm" TextColor="TextColor.MutedForeground" Style="line-height: 1.6;">
                    <JobTimestamp StartsAt="@pending" ShowAbsolute="true" Value="@timestamp" />
                </Div>
            </Div>
        }
    </Div>
</Section>
@code {
    private bool IsTerminal => Job.State is "Succeeded" or "DeadLettered" or "Cancelled";
    private string DurationLabel => TimeSpan.FromMilliseconds(Job.CompletedAt - Job.StartedAt).TotalSeconds < 60
        ? $"{(Job.CompletedAt - Job.StartedAt) / 1000d:0.#} seconds"
        : TimeSpan.FromMilliseconds(Job.CompletedAt - Job.StartedAt).ToString(@"h\:mm\:ss");

    private IEnumerable<(string Title, long Timestamp, bool Pending, int Step)> Milestones
    {
        get
        {
            var step = 1;
            yield return ("Created", Job.CreatedAt, false, step++);
            if (Job.Attempt > 0)
                yield return (Job.Attempt > 1 ? $"Attempt {Job.Attempt} started" : "Started", Job.StartedAt, false, step++);
            if (IsTerminal)
                yield return (Job.State == "DeadLettered" ? "Failed" : Job.State,
                    Job.CompletedAt > 0 ? Job.CompletedAt : Job.UpdatedAt, false, step++);
            if (Job.State == "Queued")
                yield return ("Queued", Job.DueAt, false, step);
            if (Job.State == "Scheduled")
                yield return (Job.Attempt > 0 ? "Retry due" : "Scheduled for", Job.DueAt, true, step);
        }
    }


    /// <summary>The current execution snapshot displayed in the timeline.</summary>
    [Parameter, EditorRequired]
    public JobView Job { get; set; } = null!;
}
