@namespace Soenneker.Flywheel.Dashboard
@using Soenneker.Quark
@using Soenneker.Flywheel.Communication.Responses

<style>
    @@media (max-width: 767px) {
        .flywheel-job-timeline { flex-direction: column !important; gap: 0 !important; }
        .flywheel-job-timeline > * { flex: none !important; width: 100% !important; margin-top: 0 !important; padding: 0 0 1.25rem 1.5rem !important; }
        .flywheel-job-timeline [data-slot="timeline-indicator"] { top: .375rem !important; }
        .flywheel-job-timeline [data-slot="timeline-separator"] { top: 1.125rem !important; left: 3px !important; width: 2px !important; height: calc(100% - 1rem) !important; }
    }
</style>
<Div TextSize="TextSize.Sm" Style="max-width: 40rem; min-width: 0;">
    <H3 TextSize="TextSize.Xs" FontWeight="FontWeight.Semibold" TextColor="TextColor.MutedForeground" Margin="Margin.Is0">Activity</H3>
    <Div Style="overflow-x: auto; padding-top: .5rem;" tabindex="0" role="region" aria-label="Job timeline">
        <Timeline Class="flywheel-job-timeline" Orientation="horizontal" Value="@CompletedSteps" AriaLabel="Job timeline" Style="width: 100%;">
            @foreach (var (title, timestamp, pending, step) in Milestones)
            {
                <TimelineItem Step="@step" Style="@ItemStyle">
                    <TimelineHeader>
                        <TimelineTitle Style="margin: 0 0 .375rem; font-size: .875rem; font-weight: 600;">@title</TimelineTitle>
                        <TimelineDate Style="margin: 0; line-height: 1.6;"><JobTimestamp StartsAt="@pending" ShowAbsolute="true" Value="@timestamp" /></TimelineDate>
                    </TimelineHeader>
                    <TimelineIndicator Style="@(pending ? PendingIndicatorStyle : IndicatorStyle)" />
                    <TimelineSeparator Style="@SeparatorStyle" />
                </TimelineItem>
            }
        </Timeline>
    </Div>
    <Div TextSize="TextSize.Xs" TextColor="TextColor.MutedForeground" Style="margin-top: .75rem;">
        @(Job.MaxAttempts is { } max ? $"{Job.Attempt} of {max} attempts used" : $"{Job.Attempt} attempts used")
        @if (Job.StartedAt > 0 && Job.CompletedAt >= Job.StartedAt)
        {
            <Span> · Duration: @TimeSpan.FromMilliseconds(Job.CompletedAt - Job.StartedAt).ToString("g")</Span>
        }
    </Div>
</Div>

@code {
    private bool IsTerminal => Job.State is "Succeeded" or "DeadLettered" or "Cancelled";
    private int CompletedSteps => 1 + (Job.Attempt > 0 ? 1 : 0) + (IsTerminal ? 1 : 0);

    private IEnumerable<(string Title, long Timestamp, bool Pending, int Step)> Milestones
    {
        get
        {
            var step = 1;
            yield return ("Created", Job.CreatedAt, false, step++);
            if (Job.Attempt > 0)
                yield return (Job.Attempt > 1 ? $"Attempt {Job.Attempt} started" : "Started", Job.StartedAt, false, step++);
            if (IsTerminal)
                yield return (Job.State == "DeadLettered" ? "Failed" : Job.State,
                    Job.CompletedAt > 0 ? Job.CompletedAt : Job.UpdatedAt, false, step++);
            if (Job.State == "Queued")
                yield return ("Queued", Job.DueAt, false, step);
            if (Job.State == "Scheduled")
                yield return (Job.Attempt > 0 ? "Retry due" : "Scheduled for", Job.DueAt, true, step);
        }
    }

    private const string ItemStyle = "flex: 1 1 0; min-width: 0; width: auto; margin-top: 1.25rem; padding-right: 1rem; gap: .25rem;";
    private const string IndicatorStyle = "top: -1rem; left: 0; width: .5rem; height: .5rem; transform: none; translate: none; border: 0; background: var(--primary);";
    private const string PendingIndicatorStyle = IndicatorStyle + "border: 1px solid var(--muted-foreground); background: transparent;";
    private const string SeparatorStyle = "top: calc(-1rem + 3px); left: .875rem; width: calc(100% - 1.25rem); height: 2px; transform: none; translate: none; background: var(--border);";

    /// <summary>The current execution snapshot displayed in the timeline.</summary>
    [Parameter, EditorRequired]
    public JobView Job { get; set; } = null!;
}
