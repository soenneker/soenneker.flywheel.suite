@page "/jobs/{JobId}"
@namespace Soenneker.Flywheel.Dashboard.Pages.Jobs
@using Soenneker.Quark
@using Soenneker.Flywheel.Dashboard
@layout FlywheelLayout
@inject DashboardNavigationOptions DashboardNavigation
@inherits LeptonCancellable

@if (!Embedded)
{
    <PageTitle>@(_job?.Name ?? "Job details") · Flywheel</PageTitle>
}

@if (_login)
{
    <Paragraph role="status">Your session has expired. Redirecting to sign in…</Paragraph>
}
else
{
    <Main MaxWidth='MaxWidth.Token("[1600px]")' Margin="Margin.Auto.OnX" Padding="Padding.Is4.OnMd.Is8" Width="Width.IsFull" MinWidth="MinWidth.Is0" Style="@(Embedded ? "width: 100%; max-width: none; margin: 0; padding: 0;" : "width: 100%; padding-top: 1rem;")">
        <Div Display="Display.Flex" ItemsAlign="Items.Center" Justify="Justify.Between" FlexWrap="FlexWrap.Wrap" Gap="Gap.Is4" Margin="Margin.FromBottom.Is4">
            <Div Display="Display.Flex" MinWidth="MinWidth.Is0" Style="max-width: 100%;" ItemsAlign="Items.Center" Gap="Gap.Is4" FlexWrap="FlexWrap.Wrap">
                @if (!Embedded)
                {
                    <Button Href="@(BackHref ?? DashboardNavigation.Path())" Variant="ButtonVariant.Secondary" aria-label="Back to previous page" title="Back">←</Button>
                }
                <H2 Margin="Margin.Is0" style="border: 0; padding: 0; min-width: 0; overflow-wrap: anywhere;" TextSize="TextSize.Xl" FontWeight="FontWeight.Semibold" TextBreak="TextBreak.All">@(_job?.Name ?? (_missing ? "Job not found" : "Job details"))</H2>
                @if (_job is not null)
                {
                    <JobStatusBadge State="@_job.State" CancelRequested="@_job.CancelRequested" />
                    @if (_job.State == "Running" && _job.Progress is { } progress && progress < 100)
                    {
                        <Score Value="@((int)Math.Round(progress))" ScoreSize="28" Thickness="3" Colored="false"
                               Style="flex-shrink: 0; --score-neutral-color: var(--muted-foreground); --score-value-color: var(--muted-foreground);"
                               AriaLabel="@($"Job progress: {progress:0.#}% complete")"
                               title="@(_job.ProgressMessage is { Length: > 0 } message ? $"{progress:0.#}% complete · {message}" : $"{progress:0.#}% complete")" />
                    }
                }
            </Div>
            <Div Display="Display.Flex" ItemsAlign="Items.Center" Gap="Gap.Is4" FlexWrap="FlexWrap.Wrap" Justify="Justify.End">
                @if (_job is not null)
                {
                    <Dropdown>
                        <DropdownToggle AsChild="true">
                            <Button Variant="ButtonVariant.Ghost" Size="Size.Is10" Disabled="@(_runningAgain || _cancelling)" aria-label="Job actions" title="Job actions">
                                <Span aria-hidden="true">⋯</Span>
                            </Button>
                        </DropdownToggle>
                        <DropdownMenu RightAligned="true">
                            @if (_job.State is "Succeeded" or "DeadLettered" or "Cancelled")
                            {
                                <DropdownItem Clicked="RunAgain" Disabled="@_runningAgain">Run again</DropdownItem>
                            }
                            @if (_job.State is "Queued" or "Scheduled" or "Running" or "Waiting")
                            {
                                <DropdownItem Clicked="Cancel" Disabled="@(_cancelling || _job.CancelRequested)" Variant="destructive">@(_job.CancelRequested ? "Cancellation requested" : "Cancel job")</DropdownItem>
                            }
                        </DropdownMenu>
                    </Dropdown>
                }
                @if (Embedded)
                {
                    <DrawerClose AsChild="true"><Button Variant="ButtonVariant.Secondary" aria-label="Close job details">Close</Button></DrawerClose>
                }
            </Div>
        </Div>
        @if (!string.IsNullOrWhiteSpace(_job?.Description))
        {
            <Paragraph TextColor="TextColor.MutedForeground" TextBreak="TextBreak.Words" Margin="Margin.FromBottom.Is5">@_job.Description</Paragraph>
        }
        <Grid aria-label="Job overview" Columns="GridCols.Is1" Gap="Gap.Is5" Margin="Margin.FromBottom.Is6" Style="padding: .5rem 0;">
            <Div MinWidth="MinWidth.Is0" Space="Space.Y.Is4">
                <Div MinWidth="MinWidth.Is0" Space="Space.Y.Is2" Style="width: 24rem; max-width: 100%;">
                    <Span TextSize="TextSize.Xs" TextColor="TextColor.MutedForeground" id="job-id-label" >Job ID</Span>
                    <CopyField Value="@JobId" AriaLabelledBy="job-id-label" CopyLabel="Copy job ID" CopyButtonVariant="ButtonVariant.Secondary" />
                </Div>
            </Div>
            @if (_job is not null)
            {
                <Grid aria-label="Job properties" Columns="GridCols.Is2.OnMd.Is4" Style="display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 1rem 2rem;" Gap="Gap.Is5" TextSize="TextSize.Sm">
                    <Div><Span Display="Display.Block" TextSize="TextSize.Xs" TextColor="TextColor.MutedForeground">Priority</Span><Span Display="Display.Block">@(_job.Priority ?? "Unavailable")</Span></Div>
                    <Div><Span Display="Display.Block" TextSize="TextSize.Xs" TextColor="TextColor.MutedForeground">Timeout per attempt</Span><Span Display="Display.Block">@(_job.TimeoutSeconds is { } seconds ? TimeSpan.FromSeconds(seconds).ToString("g") : "Unavailable")</Span></Div>
                    @if (_job.State == "Running")
                    {
                        <Div MinWidth="MinWidth.Is0"><Span Display="Display.Block" TextSize="TextSize.Xs" TextColor="TextColor.MutedForeground">Worker</Span><Span TextBreak="TextBreak.All">@(_job.Owner ?? "Not assigned")</Span></Div>
                    }
                    @if (_job.ParentJobId is { } parentId)
                    {
                        <Div><Span Display="Display.Block" TextSize="TextSize.Xs" TextColor="TextColor.MutedForeground">Previous step</Span><Anchor Href="@(DashboardNavigation.Path($"jobs/{Uri.EscapeDataString(parentId)}"))">View previous job</Anchor></Div>
                    }
                    @if (_job.NextJobId is { } nextId)
                    {
                        <Div><Span Display="Display.Block" TextSize="TextSize.Xs" TextColor="TextColor.MutedForeground">Next step</Span><Anchor Href="@(DashboardNavigation.Path($"jobs/{Uri.EscapeDataString(nextId)}"))">View next job</Anchor></Div>
                    }
                </Grid>
                <JobTimeline Job="@_job" />
            }
        </Grid>
        @if (_error is not null)
        {
            <Alert role="alert"><AlertTitle>Request failed</AlertTitle><AlertDescription>@_error <Button OnClick="RefreshPage" Variant="ButtonVariant.Secondary">Reload page</Button></AlertDescription></Alert>
        }
        @if (_missing)
        {
            <Div MinWidth="MinWidth.Is0" Space="Space.Y.Is4"><Div Space="Space.Y.Is1"><H3 TextSize="TextSize.Lg" FontWeight="FontWeight.Semibold">Job not found</H3></Div><Div>This job may have expired or been removed. Return to the overview to find another execution.</Div></Div>
        }
        else if (_job is null)
        {
            <Div MinWidth="MinWidth.Is0" Space="Space.Y.Is4"><Div>@if (_loading)
                {
                    <Spinner Size="Size.Is5" aria-label="Loading execution" />
                }
                else
                {
                    <Paragraph role="status">Execution details are unavailable. Reload the page to retry.</Paragraph>
                }</Div></Div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(_job.Error))
            {
                <Alert role="alert"><AlertTitle>Last execution error</AlertTitle><AlertDescription><Div Whitespace="Whitespace.PreWrap" TextBreak="TextBreak.All" FontFamily="FontFamily.Mono" TextSize="TextSize.Sm">@_job.Error</Div></AlertDescription></Alert>
            }
            <Div MinWidth="MinWidth.Is0" Space="Space.Y.Is4"><Div><JobLogConsole @key="_job.Id" JobId="@_job.Id" /></Div></Div>
        }
    </Main>
}
