@inject DashboardNavigationOptions DashboardNavigation
@page "/flywheel/recurring/{ScheduleId}"
@namespace Soenneker.Flywheel.Dashboard.Pages.Schedules
@using Soenneker.Quark
@inherits JobsPageBase
@layout FlywheelLayout
@inject ISonnerService Sonner
@inject DashboardSessionState Session

@if (!Embedded)
{
    <PageTitle>@(SelectedSchedule?.Name ?? "Schedule") · Flywheel</PageTitle>
}

<Div MinWidth="MinWidth.Is0" Padding="@(Embedded ? Padding.Is0 : Padding.Is4)">
    @if (_runError is not null)
    {
        <Alert role="alert"><AlertDescription>@_runError</AlertDescription></Alert>
    }
    @if (_scheduleError is not null)
    {
        <Alert role="alert"><AlertTitle>Could not load schedule</AlertTitle><AlertDescription>@_scheduleError</AlertDescription></Alert>
    }
    else if (SelectedSchedule is { } schedule)
    {
        <Div Display="Display.Flex" Justify="Justify.Between" ItemsAlign="Items.Start" Gap="Gap.Is4" Margin="Margin.FromBottom.Is6">
            <Div Display="Display.Flex" ItemsAlign="Items.Center" FlexWrap="FlexWrap.Wrap" Gap="Gap.Is3" MinWidth="MinWidth.Is0">
                <H2 Margin="Margin.Is0" TextSize="TextSize.Xl" TextBreak="TextBreak.Words">@schedule.Name</H2>
                <Badge Variant="BadgeVariant.Secondary">Recurring</Badge>
            </Div>
            <Div Display="Display.Flex" ItemsAlign="Items.Center" Gap="Gap.Is2" FlexWrap="FlexWrap.Wrap">
                <Button OnClick="Run" Loading="@(_running || Running)" Disabled="@(_running || Running)" Variant="ButtonVariant.Secondary">Run now</Button>
                @if (Embedded)
                {
                    <DrawerClose AsChild="true"><Button Variant="ButtonVariant.Secondary" aria-label="Close recurring job">Close</Button></DrawerClose>
                }
                else
                {
                    <Button Href="@DashboardNavigation.Path("recurring")" Variant="ButtonVariant.Secondary">All recurring jobs</Button>
                }
            </Div>
        </Div>
        <Grid Style="display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 1.5rem;" Padding="Padding.FromBottom.Is6" Border="Border.FromBottom.Is1" BorderColor="BorderColor.Border">
            <Div Space="Space.Y.Is2">
                <Span Display="Display.Block" TextSize="TextSize.Xs" TextColor="TextColor.MutedForeground">Schedule</Span>
                <Span Display="Display.Block" FontWeight="FontWeight.Medium">@(schedule.Cron is null ? $"Every {IntervalLabel(schedule.Interval)}" : schedule.Cron)</Span>
                @if (schedule.Cron is not null)
                {
                    <Span Display="Display.Block" TextSize="TextSize.Sm" TextColor="TextColor.MutedForeground">@schedule.TimeZoneId</Span>
                }
            </Div>
            <Div Space="Space.Y.Is2">
                <Div Display="Display.Flex" ItemsAlign="Items.Center" Gap="Gap.Is2">
                    <Span TextSize="TextSize.Xs" TextColor="TextColor.MutedForeground">Next execution</Span>
                    <JobStatusBadge State="Scheduled" />
                </Div>
                <JobTimestamp StartsAt="true" Value="@schedule.DueAt" ShowAbsolute="true" />
            </Div>
        </Grid>
    }
    else if (!Embedded && _schedules is null)
    {
        <Paragraph role="status">Loading schedule…</Paragraph>
    }
    else
    {
        <H2 TextSize="TextSize.Xl">Schedule unavailable</H2>
        <Paragraph>This schedule is not in the current schedule list.</Paragraph>
        <Anchor Href="@DashboardNavigation.Path("recurring")">View recurring jobs</Anchor>
    }
</Div>
