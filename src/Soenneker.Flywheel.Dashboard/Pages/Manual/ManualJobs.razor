@page "/flywheel/manual"
@namespace Soenneker.Flywheel.Dashboard.Pages.Manual
@using Soenneker.Flywheel.Communication.Responses
@using Soenneker.Quark
@layout FlywheelLayout
@inherits LeptonCancellable
@inject IFlywheelDashboardConsumer Consumer
@inject DashboardSessionState Session
@inject DashboardNavigationOptions DashboardNavigation
@inject ISonnerService Sonner

<PageTitle>Manual Jobs · Flywheel</PageTitle>
<Main Padding="Padding.Is4" Width="Width.IsFull" MinWidth="MinWidth.Is0" Space="Space.Y.Is4">
    <Div Space="Space.Y.Is1">
        <H3 TextSize="TextSize.Lg" FontWeight="FontWeight.Semibold">Manual Jobs</H3>
    </Div>
    @if (_error is not null) { <Alert role="alert"><AlertDescription>@_error</AlertDescription></Alert> }
    @if (_loadError is not null) { <Alert role="alert"><AlertDescription>@_loadError</AlertDescription></Alert> }
    <DataTable AdaptiveLayout="true" LoadingAtTop="true" IsLoading="@(_jobs is null && _loadError is null)" Options="@_options" TotalRecords="@Filtered.Count" OnInteraction="Search">
        <TopContent>
            <Div Display="Display.Flex" ItemsAlign="Items.Center" Gap="Gap.Is2" Margin="Margin.FromBottom.Is4">
                <DataTableSearch Placeholder="Search" AriaLabel="Search manual jobs" />
                <SidebarTrigger Display="Display.Flex.OnMd.None" aria-label="Open navigation menu"><Icon Name="Soenneker.Lucide.Enums.Icons.LucideIcon.Menu" Size="Size.Is5" /></SidebarTrigger>
            </Div>
        </TopContent>
        <TableContent>
            <Thead BackgroundColor="BackgroundColor.Secondary" Border="Border.FromBottom.Is2" BorderColor="BorderColor.Border">
                <Tr>
                    <Th FontWeight="FontWeight.Semibold" TextColor="TextColor.Foreground" TextSize="TextSize.Xs" TextTransform="TextTransform.Uppercase" Tracking="Tracking.Wide" Padding="Padding.OnX.Is3.OnY.Is2">Job</Th>
                    <Th FontWeight="FontWeight.Semibold" TextColor="TextColor.Foreground" TextSize="TextSize.Xs" TextTransform="TextTransform.Uppercase" Tracking="Tracking.Wide" Padding="Padding.OnX.Is3.OnY.Is2">Last execution</Th>
                    <Th FontWeight="FontWeight.Semibold" TextColor="TextColor.Foreground" TextSize="TextSize.Xs" TextTransform="TextTransform.Uppercase" Tracking="Tracking.Wide" Padding="Padding.OnX.Is3.OnY.Is2">Action</Th>
                </Tr>
            </Thead>
            <Tbody>
                @foreach (ManualJobView job in Filtered.Skip(Offset).Take(_pageSize))
                {
                    <Tr Border="Border.FromBottom.Is1" BorderColor="BorderColor.Border" @key="job.Id">
                        <Td Padding="Padding.OnX.Is3.OnY.Is1" Style="white-space: normal; overflow-wrap: anywhere;"><Span>@job.Name</Span>@if (job.Description is { Length: > 0 }) { <Paragraph TextColor="TextColor.MutedForeground">@job.Description</Paragraph> }</Td>
                        <Td Padding="Padding.OnX.Is3.OnY.Is1">
                            @if (job.LastExecutionId is { } executionId && job.LastExecutionStatus is { } status)
                            {
                                <Anchor Href="@(DashboardNavigation.Path($"jobs/{Uri.EscapeDataString(executionId)}"))"><JobStatusBadge State="@status" /></Anchor>
                            }
                            else { <Span TextColor="TextColor.MutedForeground">No execution recorded</Span> }
                        </Td>
                        <Td Padding="Padding.OnX.Is3.OnY.Is1"><JobActions Id="@job.LastExecutionId" Name="@job.Name" State="@job.LastExecutionStatus" IsDefinition="true" Disabled="@_starting.Contains(job.Id)" RunRequested="() => Run(job.Id)" Changed="Refresh" /><details><summary>Manage definition</summary><DefinitionActions Id="@job.Id" Manual="true" Changed="Refresh" /></details></Td>
                    </Tr>
                }
            </Tbody>
        </TableContent>
        <BottomContent>
            @if (_jobs is not null && Filtered.Count == 0) { <Paragraph TextColor="TextColor.MutedForeground">No matching manual jobs.</Paragraph> }
            <Div Display="Display.Flex" ItemsAlign="Items.Center" FlexWrap="FlexWrap.Wrap" Justify="Justify.Between" Gap="Gap.Is4" Margin="Margin.FromTop.Is4"><DataTablePageSizeSelector Label="Rows per page" /><DataTablePagination /></Div>
            @if (_jobs?.Count == 200) { <Small TextColor="TextColor.MutedForeground">Search and paging cover the first 200 manual jobs.</Small> }
        </BottomContent>
    </DataTable>
</Main>
