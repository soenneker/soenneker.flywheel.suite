<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <Description>A real-time Blazor dashboard for monitoring and managing Soenneker Flywheel.</Description>
        <AssemblyName>Soenneker.Flywheel.Dashboard</AssemblyName>
        <PackageId>Soenneker.Flywheel.Dashboard</PackageId>
        <PackageTags>flywheel dashboard background jobs scheduling blazor webassembly signalr monitoring flywheeldashboard blazorlibrary csharp dotnet c# .net</PackageTags>
        <Copyright>Copyright © 2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/soenneker/soenneker.flywheel.suite</PackageProjectUrl>
        <RepositoryUrl>https://github.com/soenneker/soenneker.flywheel.suite</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <LangVersion>latest</LangVersion>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Asyncs.Semaphores" Version="4.0.13" />
        <PackageReference Include="Soenneker.Quark.Suite" Version="4.0.1443" Condition="'$(UseLocalQuarkProject)' != 'true'" />
        <ProjectReference Include="$(LocalQuarkProject)" Condition="'$(UseLocalQuarkProject)' == 'true'" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
        <PackageReference Include="Soenneker.Blazor.Consumers.Core" Version="4.0.727" />
        <PackageReference Include="Soenneker.Extensions.HttpResponseMessage" Version="4.0.2533" />
        <ProjectReference Include="../Soenneker.Flywheel.Communication/Soenneker.Flywheel.Communication.csproj" />
        <PackageReference Include="Soenneker.Quark.Gen.Tailwind.Manifest" Version="4.0.249" PrivateAssets="all" />
        <PackageReference Include="Soenneker.SignalR.Web.Clients" Version="4.0.1504" />
        <PackageReference Include="Soenneker.Lucide.Icons" Version="5.0.82" />
        <PackageReference Include="Soenneker.Quark.Gen.Lucide" Version="4.0.258" PrivateAssets="all" />
    </ItemGroup>
    <ItemGroup><InternalsVisibleTo Include="Soenneker.Flywheel.Dashboard.Tests" /></ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Primitives" Version="10.0.12" />
        <PackageReference Include="Soenneker.Dtos.ProblemDetails" Version="4.0.461" />
        <PackageReference Include="Soenneker.Dtos.Results.Operation" Version="4.0.63" />
    </ItemGroup>
</Project>
